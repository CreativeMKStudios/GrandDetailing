---
import { business, nav } from '../data/site';
import { asset, href } from '../lib/paths';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href={href('/')}>
      <img src={asset('logo.png')} alt="Grand Detailing" width="404" height="112" />
    </a>
    <nav id="site-nav" class="nav" aria-label="Primary">
      {
        nav.map((item) => {
          const itemPath = href(item.href).replace(/\/$/, '') || '/';
          return (
            <a href={href(item.href)} aria-current={path === itemPath ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <a class="btn btn-gold nav-book" href={`tel:${business.phoneTel}`}>Book now</a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Open menu</span>
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
